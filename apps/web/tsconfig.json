/* Solution-style root config: it owns no sources, only the two project
   references below. The compiler settings come from the workspace contract in
   @lj/tsconfig, so this app is held to the same rules as every package rather
   than to whatever `ng new` generated. */
{
  "extends": "@lj/tsconfig/angular.json",
  "compileOnSave": false,
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
