{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/web/browser",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ]",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lj-api-jerryca.vercel.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
