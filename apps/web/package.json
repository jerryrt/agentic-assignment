{
  "name": "@lj/web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ng serve --define \"LJ_SUPABASE_URL='${SUPABASE_URL-}'\" --define \"LJ_SUPABASE_ANON_KEY='${SUPABASE_ANON_KEY-}'\"",
