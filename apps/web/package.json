    "lint": "eslint src",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@lj/db": "workspace:*",
    "@lj/domain": "workspace:*",
    "@lj/rules": "workspace:*",
    "@lj/ui": "workspace:*",
    "@lj/workflow": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@lj/tsconfig": "workspace:*",
    "jsdom": "28.0.0",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
