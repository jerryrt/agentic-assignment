{
  "name": "@lj/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens/_tokens.css": "./tokens/_tokens.css",
    "./tokens/_palette.scss": "./tokens/_palette.scss"
  },
  "scripts": {
    "typecheck": "ngc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint src tools",
    "test": "ng test --watch=false",
    "gen": "sh ./tools/generate-tokens.sh write",
    "gen:check": "sh ./tools/generate-tokens.sh check"
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/core": "22.1.4",
    "@lj/domain": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@lj/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "jsdom": "28.0.0",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
