{
  // Shared compiler options live once, in tooling/tsconfig; a package that
  // restates them drifts from the rest of the workspace without anyone noticing.
  "extends": "@lj/tsconfig/angular.json",
  // The specs are excluded here and picked up by tsconfig.spec.json instead:
  // they are the only files that see the test runner's globals, and a program
  // that includes them would have to make `describe` visible to the library.
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
