{
  "name": "land-journey",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "workflow:gen": "pnpm --filter @lj/workflow run gen",
    "workflow:check": "pnpm --filter @lj/workflow run gen:check",
    "tokens:gen": "pnpm --filter @lj/ui run gen",
    "tokens:check": "pnpm --filter @lj/ui run gen:check",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@lj/eslint-config": "workspace:*",
    "eslint": "10.9.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  }
}
