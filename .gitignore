__pycache__/
*.pyc
node_modules/
.turbo/
dist/
.env
.env.local

# Supabase CLI local state -- regenerated on demand, never shared.
# linked-project.json records whichever project ref the last `supabase link`
# used, which is per-developer and goes stale the moment a project is replaced.
supabase/.temp/
supabase/.branches/
supabase/.env

# Vercel CLI local state. `vercel env pull` writes a live copy of the project's
# environment here, which on apps/api includes the service role key.
.vercel/

# Angular incremental compile scratch space. Deliberately not a turbo output.
.angular/

.env.*.local
coverage/
out-tsc/
